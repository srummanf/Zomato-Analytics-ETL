# Copy this file to .env and adjust if needed. .env is gitignored — never
# commit real secrets. For this local academic project the defaults below
# are already what docker-compose.yml uses, so most people won't need a
# .env at all; it's here for when you want to override something (e.g. a
# different Postgres password) without editing docker-compose.yml directly.
#
# See doc/PASSWORD.md for what's actually running behind each of these.

# --- PostgreSQL (staging store) ---
# Use the "localhost" values when running a script directly on your machine
# (outside Docker). Scripts running inside the airflow container instead get
# POSTGRES_HOST=postgres / POSTGRES_PORT=5432 from docker-compose.yml itself.
POSTGRES_HOST=localhost
POSTGRES_PORT=5439
POSTGRES_DB=zomato
POSTGRES_USER=zomato
POSTGRES_PASSWORD=zomato

# --- Apache Doris (analytics warehouse) ---
DORIS_HOST=localhost
DORIS_QUERY_PORT=9030
DORIS_STREAM_LOAD_PORT=8040
DORIS_DB=zomato
DORIS_USER=root
DORIS_PASSWORD=

# --- Kaggle API (only needed for 01_download_data.py) ---
# Alternative to placing kaggle.json at ~/.kaggle/kaggle.json
KAGGLE_USERNAME=
KAGGLE_KEY=
